# --- SAP BTP ABAP Environment (trial) connection --------------------------
# ABAP_HOST, OAUTH_URL, CLIENT_ID and CLIENT_SECRET come from a service key of
# your ABAP environment instance
# (BTP cockpit -> Instances and Subscriptions -> Service Keys).

# Base URL of your ABAP system - service key "url" (no trailing slash)
ABAP_HOST=https://your-subdomain.abap.us10.hana.ondemand.com

# XSUAA host - service key "uaa.url"
OAUTH_URL=https://your-subdomain.authentication.us10.hana.ondemand.com

# Service key "uaa.clientid" / "uaa.clientsecret"
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret

# Trial systems use client 100
SAP_CLIENT=100

# --- Your developer login (OAuth password grant) -------------------------
# The same BTP/ABAP credentials you use for ADT in Eclipse / VS Code.
# Required.
ABAP_USERNAME=your_btp_username
ABAP_PASSWORD=your_btp_password
